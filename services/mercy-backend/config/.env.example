# Mercy Launcher Linux infrastructure — environment variables
# Copy to .env (in this same config/ directory) and fill in real values.
# NEVER commit the real .env file.
#
# Reconciled against reference/client/linux-backend-client-contract.md — see
# docs/backend-architecture.md for how each of these is actually used.

# --- Supabase (service-role, server-side only) ---
# Same project the Windows client's src/renderer/lib/supabase.ts points at.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Used to verify a host's Supabase Auth JWT presented as HelloMessage.token
# for role:'host' (see docs/backend-architecture.md §3). Project Settings ->
# API -> JWT Secret in the Supabase dashboard.
SUPABASE_JWT_SECRET=

# --- mercy-relay (single WebSocket + health-HTTP process, see ecosystem.config.js) ---
MERCY_RELAY_PORT=4200
MERCY_SIGNALING_LOG_LEVEL=info

# Resource-exhaustion controls (Step 9) — not part of protocol.ts, relay-side only.
MERCY_RELAY_MAX_CONNECTIONS=500
MERCY_RELAY_MAX_CONCURRENT_SESSIONS=200
MERCY_RELAY_MAX_MESSAGE_BYTES=65536

# --- mercy-api (REST + WebSocket presence service, api/server.js) ---
# Friends/Presence/Everyone-Playing/servers/join-requests data. Identity is
# still Supabase Auth (verified via the SUPABASE_* vars above, same
# service-role client mercy-relay already uses) — this is ONLY the local
# Postgres connection for Mercy application data, never a login credential.
MERCY_API_PORT=4201

# Dedicated non-superuser Postgres role — see the one-time setup instructions
# given separately (CREATE ROLE mercy_backend ... ; CREATE DATABASE
# mercy_backend OWNER mercy_backend;). Either set MERCY_API_DATABASE_URL as a
# single connection string, or fill in the individual MERCY_API_DB_* vars.
MERCY_API_DATABASE_URL=
MERCY_API_DB_HOST=127.0.0.1
MERCY_API_DB_PORT=5432
MERCY_API_DB_NAME=mercy_backend
MERCY_API_DB_USER=mercy_backend
MERCY_API_DB_PASSWORD=
MERCY_API_DB_POOL_MAX=10

# Presence/join-request timing.
MERCY_API_PRESENCE_STALE_MS=90000
MERCY_API_JOIN_REQUEST_TTL_MS=120000
MERCY_API_STALE_SWEEP_INTERVAL_MS=30000

# WebSocket presence-channel heartbeat.
MERCY_API_WS_PING_INTERVAL_MS=20000
MERCY_API_WS_PING_TIMEOUT_MS=45000
MERCY_API_WS_HELLO_TIMEOUT_MS=5000

MERCY_API_MAX_CONNECTIONS=1000
