{
  "name": "mercy-linux-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Mercy Launcher Linux infrastructure: signaling + relay for NAT-free join connections, plus the Mercy API (Friends/Presence/servers/join-requests)",
  "type": "commonjs",
  "main": "relay/server.js",
  "scripts": {
    "start": "node relay/server.js",
    "start:api": "node api/server.js",
    "migrate:api": "node api/migrate.js",
    "test": "node --test tests/*.test.js",
    "test:api": "node --test --test-concurrency=1 tests/api/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "ws": "^8.18.0"
  }
}
