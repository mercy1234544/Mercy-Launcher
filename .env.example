# Mercy Launcher — real deployment configuration.
#
# Copy this file to `.env` at the repo root and fill in real values. `.env`
# is already gitignored (see .gitignore) — never commit real credentials.
# Vite only exposes variables prefixed VITE_ to renderer code (see
# src/renderer/vite-env.d.ts), which is why every key below has that prefix.
#
# Leaving any of these unset is safe: the app falls back to its existing
# honest "not deployed yet" behavior (see src/renderer/lib/supabase.ts /
# isSupabaseConfigured(), and src/main/services/connection/ConnectionNegotiator.ts).

# ── Supabase (accounts, friends, presence — supabase/schema.sql +
#    supabase/friends_presence_schema.sql) ──────────────────────────────────
# Supabase → Project Settings → API → "Project URL" / "anon public" key.
# The anon key is meant to be public — Row Level Security enforces access,
# not secrecy of this key. NEVER put a service-role key in this file or
# anywhere in the renderer; the renderer must only ever hold the anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Mercy relay/signaling service (see
#    src/main/services/connection/protocol.ts for the exact WebSocket
#    protocol this connects with) ───────────────────────────────────────────
# A wss:// URL for Mercy's relay/signaling backend. Requires a real deployed
# Linux service implementing protocol.ts — no such service ships with this
# repo. Until set, join negotiation can only ever produce LAN-direct or
# UPnP/NAT-mapped-direct connections; anything that would need a relay
# honestly reports "relay required, not available" instead of pretending
# to work.
VITE_MERCY_RELAY_WS_URL=
